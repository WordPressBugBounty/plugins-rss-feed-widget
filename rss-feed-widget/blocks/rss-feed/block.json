{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "rss-feed-widget/feed",
	"title": "RSS Feed",
	"category": "widgets",
	"icon": "rss",
	"description": "Show an RSS or Atom feed as a list or slider.",
	"keywords": [ "rss", "feed", "atom", "news", "slider" ],
	"textdomain": "rss-feed-widget",
	"editorScript": "file:./index.js",
	"supports": { "html": false, "align": [ "wide", "full" ], "spacing": { "margin": true, "padding": true } },
	"attributes": {
		"rss_url": { "type": "string", "default": "" },
		"title": { "type": "string", "default": "" },
		"number": { "type": "integer", "default": 6 },
		"list_type": { "type": "string", "default": "list" },
		"content_display": { "type": "string", "default": "default" },
		"content_order": { "type": "string", "default": "default" },
		"text_to_display": { "type": "string", "default": "default" },
		"feed_words": { "type": "integer", "default": 40 },
		"show_feed_title": { "type": "boolean", "default": true },
		"keep_feed_link": { "type": "boolean", "default": true },
		"new_tab": { "type": "boolean", "default": true },
		"show_date": { "type": "boolean", "default": true },
		"show_source": { "type": "boolean", "default": false },
		"autoplay": { "type": "boolean", "default": true },
		"speed": { "type": "integer", "default": 500 },
		"pause": { "type": "integer", "default": 8000 },
		"img_size": { "type": "string", "default": "small" },
		"content_height": { "type": "string", "default": "" },
		"rfw_cache": { "type": "integer", "default": 0 },
		"rfw_censorship": { "type": "string", "default": "" }
	}
}
